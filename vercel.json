{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/ueber-uns", "destination": "/ueber-uns/danyal", "permanent": true },
    { "source": "/en/about", "destination": "/en/about/danyal", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(danyal-hero.jpeg|facebook-cover-en.png|DMR-testimonial-loganberry.png|DMR-loganberry-proof.png)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|woff|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
